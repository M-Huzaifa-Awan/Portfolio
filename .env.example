# Server-only Web3Forms key (https://web3forms.com — free).
# Never expose this as NEXT_PUBLIC_*. Without it, contact falls back to mailto.
WEB3FORMS_KEY=

# Cloudflare Turnstile (free). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Hostnames: huzaifaawan.com, www.huzaifaawan.com, localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub username used by the GitHub Activity section.
NEXT_PUBLIC_GITHUB_USER=M-Huzaifa-Awan

# Optional: show Umami's "online" count (last 5 minutes) instead of first-party
# presence. Create a key in Umami Cloud → Settings → API keys.
# UMAMI_API_KEY=
# UMAMI_WEBSITE_ID=
# UMAMI_API_URL=https://api.umami.is/v1

# Optional: shared store so the live count and form rate limits stay accurate
# on Vercel. Free Redis from https://upstash.com — without it, both are per-instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
